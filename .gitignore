# Secrets
.env
.env_b
.env_*
wallets/*.env
*.key
credentials*

# Runtime caches (Codex, pre-commit, etc.)
.codex_tmp/
.cache/
.coverage
htmlcov/

# Python
.venv
.venv/
__pycache__/
*.pyc
*.pyo

# Frontend
node_modules/
/package-lock.json
frontend/**/dist/
frontend/**/.vite/
frontend/**/playwright-report/
frontend/**/test-results/
*.tsbuildinfo

# Data (too large for git, 3.3GB). Keep layout docs tracked.
/data/**
!/data/**/
!/data/**/*.md
!/data/derived/ops/archive_feed.jsonl
!/data/derived/research_board/registry.json
!/data/derived/data_dictionary/registry.json

# Derived daily reports (regenerated by scripts, don't track snapshots)
data/derived/reports/*.md
data/derived/reports/**/*.md
data/derived/reports/**/*.csv
data/derived/weather_edge/*.md
data/derived/weather_edge/**/*.md
data/derived/weather_edge/**/*.csv
data/derived/tmp/

# Logs (runtime artifacts)
logs/

# Runtime artifacts under runs/ (heartbeats, PIDs, config version log, models,
# redirected stdout/stderr from long-running processes).
runs/heartbeat*.json
runs/trade_collector_daily.json
runs/config_versions.jsonl
runs/tick_decisions.jsonl
runs/tick_trace.jsonl
runs/*.pid
runs/*.log
runs/models/
runs/*.png
runs/trade_collector_daily_wallets.json
runs/*leaderboard_wallet*
runs/*deep_dive_light.*
runs/*entry_forensics*
runs/wallet_*_updown_*.csv
runs/wallet_*_updown_*.json

# Backups
*.bak

# Parquet (data files — too large, typically derived from /data/)
**/*.parquet

# Archive (fresh-start migration). Track the manifest + small structural files;
# skip the bulk binary content. Off-repo backup at ~/migration-backup-2026-05/
# is the canonical full snapshot if the bulk is ever needed.
archive/**/*.jsonl
archive/**/*.csv
archive/**/*.zip
archive/**/__pycache__/

# Large research raw dumps under docs/ (observation logs, api call logs, probe traces)
# Keep WORK_REPORT.md / analysis.py / results.json tracked; skip the bulk raw data.
docs/**/observation.jsonl
docs/**/spotfeed_probe.jsonl
docs/**/api_call_log.csv
logs/run_live/latency.jsonl

# OS
.DS_Store

# Tmp
/tmp/
*.tmp

# Codex CLI companion error log
/error.log

# Claude Code runtime state
.claude/

# Arm/kill flags are LIVE CONTROLS, never repo state: a tracked flag gets
# resurrected by pre-commit's unstaged-stash during hook runs and can fire
# real money after an operator disarm (2026-08-16 incident, C116)
runs/TERMINAL_LIVE_ARMED*
runs/KILL_SWITCH
# VALIDATION_STOP is the same class with the sign flipped: copy-live's
# last START lock listed it as the ONLY reason it did not trade, so
# losing this file arms real money 40s later (2026-08-25 sweep).
runs/VALIDATION_STOP

# Runtime state that scheduled jobs append. It used to live in the tracked
# docs/ tree, so every run left the worktree dirty and every commit raced
# pre-commit's stash -- which on 2026-08-30 orphaned fourteen such files into
# ~/.cache/pre-commit/ when a hook timed out. Writers now target
# data/derived/research/; these two lines keep the historical copies from
# coming back if something old writes them again.
docs/analysis/r51/runtime_log.jsonl
docs/analysis/r53/runtime_log.jsonl
